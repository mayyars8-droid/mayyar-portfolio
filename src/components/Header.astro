---
import { NAV, SITE } from '@/lib/site';
---

<header class="fixed top-4 left-1/2 z-50 -translate-x-1/2 px-3 sm:px-4 w-[min(96vw,1200px)]">
  <div class="flex items-center justify-between rounded-full bg-paper/85 backdrop-blur-md border border-ink/10 shadow-[0_8px_30px_-12px_rgba(20,20,15,0.18)] px-3 sm:px-4 py-2">
    <a href="#hero" class="flex items-center gap-2 group" data-cursor-link>
      <span
        class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-ink text-cream font-display text-sm font-semibold transition-transform group-hover:rotate-12"
        aria-hidden="true">M</span>
      <span class="font-display tracking-tight text-[15px] text-ink">
        Mayyar<span class="text-coral">.</span>
      </span>
    </a>

    <nav aria-label="Primary" class="hidden md:flex items-center gap-1">
      {NAV.map(({ href, label }) => (
        <a
          href={href}
          data-cursor-link
          class="px-3 py-1.5 rounded-full text-sm text-ink-soft hover:bg-ink hover:text-cream transition-colors"
        >
          {label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={SITE.calendly}
        target="_blank"
        rel="noopener noreferrer"
        data-cursor-link
        class="hidden sm:inline-flex items-center gap-1.5 rounded-full bg-ink text-cream text-sm px-4 py-2 font-medium hover:bg-coral transition-colors"
      >
        Book a call
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M7 17L17 7" />
          <path d="M8 7h9v9" />
        </svg>
      </a>

      <button
        id="menu-toggle"
        class="md:hidden inline-flex items-center justify-center w-9 h-9 rounded-full border border-ink/15 text-ink"
        aria-label="Toggle navigation"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-cursor-link
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 7h16" />
          <path d="M4 12h16" />
          <path d="M4 17h16" />
        </svg>
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="md:hidden mt-2 hidden rounded-3xl bg-paper border border-ink/10 shadow-lg p-3 flex-col gap-1"
  >
    {NAV.map(({ href, label }) => (
      <a
        href={href}
        class="block px-4 py-3 rounded-2xl text-ink hover:bg-cream-2 transition-colors"
      >
        {label}
      </a>
    ))}
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const open = menu.classList.toggle('hidden') === false;
      menu.classList.toggle('flex', open);
      toggle.setAttribute('aria-expanded', String(open));
    });
    menu.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => {
        menu.classList.add('hidden');
        menu.classList.remove('flex');
        toggle.setAttribute('aria-expanded', 'false');
      }),
    );
  }
</script>
