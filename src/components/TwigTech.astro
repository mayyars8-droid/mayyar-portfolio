---
const channels = [
  { label: 'YouTube', detail: 'Long-form, cinematic feel' },
  { label: 'Instagram', detail: 'Daily, visual-first' },
  { label: 'TikTok', detail: 'Sharp, snackable' },
];
---

<section
  id="twig-tech"
  class="relative py-20 sm:py-32 overflow-hidden grain"
>
  <div class="max-w-7xl mx-auto px-6 sm:px-10">
    <div class="relative rounded-[2rem] sm:rounded-[2.5rem] overflow-hidden bg-gradient-to-br from-blue via-blue/90 to-ink text-cream p-7 sm:p-12 md:p-16">
      <div
        aria-hidden="true"
        class="pointer-events-none absolute -top-40 -right-40 h-[60vmin] w-[60vmin] rounded-full bg-coral/40 blur-[120px]"
      ></div>
      <div
        aria-hidden="true"
        class="pointer-events-none absolute -bottom-32 -left-32 h-[50vmin] w-[50vmin] rounded-full bg-cream/15 blur-[120px]"
      ></div>

      <div class="relative grid grid-cols-1 md:grid-cols-12 gap-10 items-center">
        <div class="md:col-span-7" data-reveal>
          <p class="font-mono text-xs tracking-[0.3em] text-cream/60">
            // SIDE PROJECT
          </p>
          <h2
            class="mt-5 font-display leading-[0.95] tracking-tight text-balance"
            style="font-size: clamp(2.4rem, 6.5vw, 5.5rem);"
          >
            <span class="block">Twig Tech</span>
            <span class="block text-cream/85">
              Arabic tech, told <em class="not-italic text-coral">cinematically</em>.
            </span>
          </h2>
          <p class="mt-6 max-w-lg text-cream/80 text-pretty">
            A creator brand turning gadgets, apps and ideas into short, beautiful
            stories — produced, designed and edited end-to-end.
          </p>

          <div class="mt-8 sm:mt-10 flex flex-wrap gap-3">
            {channels.map((c) => (
              <span class="inline-flex items-center gap-2 rounded-full border border-cream/25 px-3 sm:px-4 py-2 text-sm">
                <span class="w-1.5 h-1.5 rounded-full bg-coral animate-pulse"></span>
                {c.label}
                <span class="hidden sm:inline font-mono text-[10px] tracking-[0.18em] uppercase text-cream/55">
                  · {c.detail}
                </span>
              </span>
            ))}
          </div>
        </div>

        <div class="md:col-span-5 relative" data-reveal>
          <div class="relative aspect-[3/4] rounded-3xl overflow-hidden bg-ink shadow-2xl">
            <img
              src="https://img.youtube.com/vi/hqmtwFmK7Is/hqdefault.jpg"
              alt="Twig Tech"
              class="absolute inset-0 w-full h-full object-cover"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-ink/70 via-transparent to-transparent"></div>
            <div class="absolute bottom-4 left-4 right-4 flex items-center justify-between font-mono text-[10px] tracking-[0.2em] uppercase text-cream/85">
              <span>Twig Tech</span>
              <span>Now streaming</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
