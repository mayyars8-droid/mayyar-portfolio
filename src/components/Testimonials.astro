---
import { TESTIMONIALS } from '@/lib/site';

interface Props {
  variant?: 'light' | 'dark';
  heading?: string;
  eyebrow?: string;
}
const {
  variant = 'light',
  heading = 'Top Rated with proof, not adjectives.',
  eyebrow = '// SOCIAL PROOF',
} = Astro.props;

const isDark = variant === 'dark';
---

<section
  id="testimonials"
  class:list={[
    'relative py-20 sm:py-28 overflow-hidden',
    isDark ? 'bg-ink text-cream' : 'bg-paper text-ink',
  ]}
>
  <div class="max-w-7xl mx-auto px-6 sm:px-10">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-8 mb-12">
      <div>
        <p class:list={['font-mono text-xs tracking-[0.3em]', isDark ? 'text-cream/55' : 'text-ink-soft']} data-reveal>
          {eyebrow}
        </p>
        <h2
          class="mt-5 font-display leading-[0.95] tracking-tight text-balance"
          style="font-size: clamp(2rem, 5.5vw, 4.5rem);"
          data-reveal
        >
          {heading}
        </h2>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 sm:gap-7">
      {TESTIMONIALS.map((t, i) => (
        <figure
          data-reveal
          style={`--reveal-delay:${i * 80}ms`}
          class:list={[
            'flex flex-col rounded-3xl border p-7 sm:p-8',
            isDark
              ? 'border-cream/15 bg-paper/[0.04] backdrop-blur-sm'
              : 'border-ink/10 bg-cream-2/40',
          ]}
        >
          <svg
            class:list={['w-8 h-8 shrink-0', isDark ? 'text-coral' : 'text-coral']}
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M9.6 6c-3.3 0-6 2.4-6 5.4v6.6h6v-6.6H6c0-2 1.6-3.4 3.6-3.4V6zm10.8 0c-3.3 0-6 2.4-6 5.4v6.6h6v-6.6h-3.6c0-2 1.6-3.4 3.6-3.4V6z" />
          </svg>
          <blockquote
            class:list={[
              'mt-5 text-base sm:text-lg leading-relaxed text-pretty',
              isDark ? 'text-cream/90' : 'text-ink/90',
            ]}
          >
            “{t.quote}”
          </blockquote>
          <figcaption
            class:list={[
              'mt-auto pt-6 border-t',
              isDark ? 'border-cream/15' : 'border-ink/10',
            ]}
          >
            <p class:list={['font-display text-lg', isDark ? 'text-cream' : 'text-ink']}>
              {t.author}
            </p>
            <p class:list={['mt-1 font-mono text-[10px] tracking-[0.2em] uppercase', isDark ? 'text-cream/60' : 'text-ink-soft']}>
              {t.role}{t.meta ? ` · ${t.meta}` : ''}
            </p>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
