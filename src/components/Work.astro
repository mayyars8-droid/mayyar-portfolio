---
/**
 * Featured Work — filterable project grid.
 *
 * Pulls from the `projects` content collection. Excludes the AI category
 * here because it has its own dedicated AI Lab section below.
 */
import { getCollection } from 'astro:content';
import ProjectCard from '@/components/ProjectCard.astro';
import { CATEGORIES } from '@/lib/site';

const all = await getCollection('projects');
const projects = all
  .filter((p) => p.data.category !== 'ai')
  .sort((a, b) => (b.data.order ?? 0) - (a.data.order ?? 0));

// Categories visible in the work tab bar (AI excluded; it has its own section).
const visibleCats = CATEGORIES.filter((c) => c.id !== 'ai');
---

<section id="work" class="work">
  <div class="wrap-wide">
    <header class="work-head">
      <span class="eyebrow" data-reveal>Featured work · Selected case frames</span>
      <h2 class="work-title text-balance" data-reveal style="--reveal-delay: 80ms;">
        A reel of stories — film, motion, design and content.
      </h2>
      <p class="work-lede" data-reveal style="--reveal-delay: 160ms;">
        Tap any card to open the full piece. Each project is curated and presented
        as a small frame from a wider creative practice.
      </p>
    </header>

    <div class="work-controls" data-reveal>
      <div class="tabs" role="tablist" aria-label="Filter work">
        <button class="tab" role="tab" data-filter="all" aria-selected="true">All</button>
        {visibleCats.map((c) => (
          <button class="tab" role="tab" data-filter={c.id} aria-selected="false">{c.label}</button>
        ))}
      </div>
      <p class="work-count" id="work-count">{projects.length} projects</p>
    </div>

    <div class="work-grid" id="work-grid">
      {projects.map((p, i) => (
        <div class="work-cell" style={`--reveal-delay: ${(i % 6) * 70}ms;`} data-reveal data-cat={p.data.category}>
          <ProjectCard
            title={p.data.title}
            category={p.data.category}
            tagline={p.data.tagline}
            year={p.data.year}
            thumbnail={p.data.thumbnail}
            media={p.data.media}
            vertical={p.data.vertical}
            tags={p.data.tags}
            external={p.data.external}
          />
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  (() => {
    const grid = document.getElementById('work-grid');
    const count = document.getElementById('work-count');
    if (!grid) return;
    const tabs = document.querySelectorAll<HTMLButtonElement>('#work .tab');
    const cells = grid.querySelectorAll<HTMLElement>('.work-cell');
    function applyFilter(cat: string) {
      let shown = 0;
      cells.forEach((cell) => {
        const ok = cat === 'all' || cell.dataset.cat === cat;
        cell.style.display = ok ? '' : 'none';
        if (ok) shown++;
      });
      if (count) count.textContent = `${shown} project${shown === 1 ? '' : 's'}`;
    }
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
        applyFilter(tab.dataset.filter || 'all');
      });
    });
  })();
</script>

<style>
  .work {
    padding-block: clamp(5rem, 12vw, 8rem);
    background: var(--bg);
  }
  .work-head { max-width: 60rem; margin-bottom: clamp(2rem, 4vw, 3rem); display: flex; flex-direction: column; gap: 1rem; }
  .work-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.6rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }
  .work-lede { color: var(--fg-soft); max-width: 56ch; line-height: 1.6; }

  .work-controls {
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .work-count {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--mute);
  }

  .work-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.4rem;
  }
  @media (min-width: 700px) { .work-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1080px) { .work-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
