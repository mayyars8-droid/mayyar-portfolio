---
/**
 * Process — 5-step creative workflow.
 * Designed as a horizontal timeline that reflows vertical on small screens.
 */
import { PROCESS } from '@/lib/site';
---

<section id="process" class="process">
  <div class="wrap">
    <header class="process-head">
      <span class="eyebrow" data-reveal>How we work · Process</span>
      <h2 class="process-title text-balance" data-reveal style="--reveal-delay: 80ms;">
        Strategy first. <em>Cinema</em> second. Delivery, always on time.
      </h2>
      <p class="process-lede" data-reveal style="--reveal-delay: 160ms;">
        A simple flow that scales from a one-week social cut to a three-month
        campaign. Built for clarity, momentum and creative quality.
      </p>
    </header>

    <ol class="process-row" role="list">
      {PROCESS.map((p, i) => (
        <li class="step" data-reveal style={`--reveal-delay: ${i * 90}ms;`}>
          <div class="step-head">
            <span class="step-code">{p.code}</span>
            <span class="step-line" aria-hidden="true"></span>
          </div>
          <h3 class="step-name">{p.name}</h3>
          <p class="step-blurb">{p.blurb}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .process {
    padding-block: clamp(5rem, 12vw, 8rem);
    background: var(--bg-elev);
    border-block: 1px solid var(--line);
  }
  .process-head { max-width: 60rem; margin-bottom: clamp(2.5rem, 5vw, 4rem); display: flex; flex-direction: column; gap: 1rem; }
  .process-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.6rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }
  .process-title em { font-style: italic; color: var(--accent); }
  .process-lede { color: var(--fg-soft); max-width: 56ch; line-height: 1.6; }

  .process-row {
    list-style: none; margin: 0; padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.4rem;
  }
  @media (min-width: 760px) { .process-row { grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 1rem; } }

  .step { display: flex; flex-direction: column; gap: 0.6rem; padding-top: 0.4rem; }
  .step-head {
    display: flex; align-items: center; gap: 0.6rem;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid var(--line);
  }
  .step-code {
    width: 30px; height: 30px;
    display: grid; place-items: center;
    border: 1px solid var(--accent);
    color: var(--accent);
    border-radius: 999px;
    font-family: var(--font-mono); font-size: 0.7rem;
  }
  .step-line { flex: 1; height: 1px; background: var(--line); }

  .step-name {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 1.8vw, 1.4rem);
    margin: 0;
  }
  .step-blurb { color: var(--fg-soft); font-size: 0.92rem; line-height: 1.55; }
</style>
