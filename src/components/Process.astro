---
const steps = [
  {
    number: '01',
    title: 'Direction',
    body: 'Brief, references, mood. We agree on the story before a single pixel is committed.',
  },
  {
    number: '02',
    title: 'Production',
    body: 'Pre-pro, shoot, design system, illustration — built with intent, not by accident.',
  },
  {
    number: '03',
    title: 'Edit & Motion',
    body: 'The cut is where the story really gets written. Pacing, sound, kinetic type, colour.',
  },
  {
    number: '04',
    title: 'AI-assist',
    body: 'Generative tools accelerate iteration: variations, mockups, clean-up, ideation — never the final word.',
  },
  {
    number: '05',
    title: 'Ship',
    body: 'Master files, social cut-downs, export specs and a tidy delivery — ready for the feed.',
  },
];
---

<section id="process" class="relative py-24 sm:py-36 bg-cream-2/60 overflow-hidden grain">
  <div class="max-w-7xl mx-auto px-6 sm:px-10">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10">
      <div class="md:col-span-4 md:sticky md:top-32 self-start">
        <p class="font-mono text-xs tracking-[0.3em] text-ink-soft" data-reveal>
          // 04 · PROCESS
        </p>
        <h2
          class="mt-5 font-display leading-[0.95] tracking-tight text-balance"
          style="font-size: clamp(2.2rem, 5.5vw, 4.5rem);"
          data-reveal
        >
          From <em class="not-italic text-coral">brief</em> to broadcast.
        </h2>
        <p class="mt-6 max-w-sm text-ink-soft text-pretty" data-reveal>
          A simple, story-first pipeline that scales from a thirty-second social
          cut to a multi-week brand campaign.
        </p>
      </div>

      <ol class="md:col-span-8 relative space-y-3 sm:space-y-4">
        {steps.map((step, i) => (
          <li
            data-reveal
            style={`--reveal-delay:${i * 60}ms`}
            class="group relative bg-paper border border-ink/10 rounded-3xl p-6 sm:p-8 hover:border-ink/30 transition-colors"
          >
            <div class="flex items-baseline justify-between gap-6">
              <div class="flex items-baseline gap-5 sm:gap-7">
                <span class="font-mono text-xs tracking-[0.2em] text-coral">
                  {step.number}
                </span>
                <h3 class="font-display text-2xl sm:text-3xl leading-tight">
                  {step.title}
                </h3>
              </div>
              <span
                aria-hidden="true"
                class="hidden sm:inline-block w-8 h-8 rounded-full border border-ink/15 grid place-items-center group-hover:bg-ink group-hover:text-cream group-hover:border-ink transition-colors"
              >
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M9 6l6 6-6 6" />
                </svg>
              </span>
            </div>
            <p class="mt-3 ml-0 sm:ml-12 max-w-2xl text-ink-soft text-pretty">
              {step.body}
            </p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
