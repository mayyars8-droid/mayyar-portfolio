---
/**
 * About — personal narrative + portrait + quick stats.
 */
import { SITE } from '@/lib/site';
---

<section id="about" class="about grain">
  <div class="wrap about-inner">
    <div class="about-image" data-reveal>
      <div class="about-frame">
        <img
          src={SITE.portrait}
          alt={`${SITE.author} portrait`}
          loading="lazy"
          decoding="async"
          width="800"
          height="1000"
        />
        <span class="about-frame-tag">FRAME · 042</span>
      </div>
      <div class="about-stamp">
        <span class="stamp-row">{SITE.award}</span>
        <span class="stamp-row">·</span>
        <span class="stamp-row">{SITE.awardSecondary}</span>
      </div>
    </div>

    <div class="about-copy">
      <span class="eyebrow" data-reveal>About · The maker behind the work</span>
      <h2 class="about-headline text-balance" data-reveal style="--reveal-delay: 80ms;">
        I make things that <em>look</em> good and <em>perform</em>.
      </h2>

      <div class="about-body" data-reveal style="--reveal-delay: 160ms;">
        <p>
          Born in <strong>Irbid, Jordan</strong>, I trained as a visual designer at the
          Jordan University of Science and Technology, where I graduated as <strong>top of
          my batch</strong>. Since then I've spent every year deepening my craft across
          design, film, editing and AI — each discipline sharpening the next.
        </p>
        <p>
          Today I lead media at <strong>High Gate Academy</strong>, run a top-rated
          freelance practice on Upwork, and partner with brands and studios on
          campaigns, films, and AI-driven content systems. I work in-house with my own
          production setup, which means I can move from concept to camera to cut to
          delivery without losing momentum.
        </p>
        <p class="about-philosophy">
          <span class="philosophy-tag">Creative Philosophy</span>
          A great frame is engineered, not stumbled upon. I treat every project — a
          15-second reel or a 5-minute documentary — as a small piece of cinema with
          a beginning, a middle, and a reason to exist.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    padding-block: clamp(5rem, 12vw, 8rem);
    background: var(--bg-elev);
    border-block: 1px solid var(--line);
  }
  .about-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: start;
  }
  @media (min-width: 980px) {
    .about-inner { grid-template-columns: minmax(280px, 420px) 1fr; }
  }

  .about-image { position: relative; }
  .about-frame {
    position: relative;
    border: 1px solid var(--line-strong);
    border-radius: 16px;
    overflow: hidden;
    background: var(--bg);
  }
  .about-frame img { aspect-ratio: 4 / 5; object-fit: cover; width: 100%; height: auto; }
  .about-frame-tag {
    position: absolute;
    top: 12px; left: 12px;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    color: #fff;
    background: rgba(7,7,10,0.6);
    backdrop-filter: blur(6px);
    padding: 0.3rem 0.55rem;
    border-radius: 4px;
  }

  .about-stamp {
    margin-top: 1.4rem;
    display: flex; flex-wrap: wrap; gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--mute);
  }
  .stamp-row { padding: 0.3rem 0.6rem; border: 1px dashed var(--line-strong); border-radius: 999px; }

  .about-copy { display: flex; flex-direction: column; gap: 1.2rem; }
  .about-headline {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.6rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }
  .about-headline em { font-style: italic; color: var(--accent); }

  .about-body { display: flex; flex-direction: column; gap: 1rem; max-width: 60ch; }
  .about-body p {
    color: var(--fg-soft);
    font-size: clamp(1rem, 1.2vw, 1.06rem);
    line-height: 1.65;
  }
  .about-body strong { color: var(--fg); font-weight: 600; }

  .about-philosophy {
    margin-top: 0.5rem;
    padding: 1.2rem 1.3rem;
    border: 1px solid var(--line);
    border-left: 3px solid var(--accent);
    border-radius: 12px;
    background: var(--surface);
  }
  .philosophy-tag {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.6rem;
  }
</style>
