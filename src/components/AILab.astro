---
/**
 * AI Lab — dedicated section showing AI-augmented practice.
 *
 * Frames AI as a creative tool inside a real production pipeline,
 * not a gimmick. Pulls AI-tagged projects from the content collection.
 */
import { getCollection } from 'astro:content';

const all = await getCollection('projects');
const aiProjects = all
  .filter((p) => p.data.category === 'ai')
  .sort((a, b) => (b.data.order ?? 0) - (a.data.order ?? 0));

const capabilities = [
  { code: 'M1', title: 'Concept generation', body: 'Mood frames, references and worldbuilding from a creative brief.' },
  { code: 'M2', title: 'Image / video synthesis', body: 'Cinematic frames, vertical clips and storyboards via Midjourney, Runway and ComfyUI.' },
  { code: 'M3', title: 'Pipeline automation', body: 'Custom workflows that route prompts → renders → post in a single chain.' },
  { code: 'M4', title: 'Editorial direction', body: 'Taste-led curation so AI-assisted output still feels human and on-brand.' },
];
---

<section id="ai-lab" class="ailab">
  <div class="ailab-canvas" aria-hidden="true">
    <div class="ailab-grid"></div>
    <div class="ailab-glow"></div>
  </div>

  <div class="wrap-wide ailab-inner">
    <header class="ailab-head">
      <span class="eyebrow" data-reveal>AI · Creative Technology</span>
      <h2 class="ailab-title text-balance" data-reveal style="--reveal-delay: 80ms;">
        AI as a <em>creative partner</em>, not a shortcut.
      </h2>
      <p class="ailab-lede" data-reveal style="--reveal-delay: 160ms;">
        I build production pipelines that pair generative tools with strong creative
        direction — preserving taste, accelerating ideation, and unlocking visual
        ideas that wouldn't be feasible by hand.
      </p>
    </header>

    <div class="ailab-cols">
      <ul class="ailab-caps" role="list">
        {capabilities.map((c, i) => (
          <li class="ai-cap" data-reveal style={`--reveal-delay: ${i * 70}ms;`}>
            <span class="ai-cap-code">{c.code}</span>
            <div>
              <h3 class="ai-cap-title">{c.title}</h3>
              <p class="ai-cap-body">{c.body}</p>
            </div>
          </li>
        ))}
      </ul>

      <div class="ailab-prompt" data-reveal>
        <span class="ai-pl">/PROMPT</span>
        <p class="ai-pt">
          "A cinematic 9:16 frame of a desert filmmaker at golden hour, shot on Arri,
          warm grade, soft grain, 35mm, the rotating word <em>Vision · Intelligence ·
          Motion · Impact</em> projected on the dune."
        </p>
        <span class="ai-pl">/SYS</span>
        <p class="ai-pb">RUNWAY GEN-3 · COMFYUI · CUSTOM EDIT PASS</p>
      </div>
    </div>

    {aiProjects.length > 0 && (
      <div class="ailab-grid-cards">
        {aiProjects.map((p, i) => {
          const payload = JSON.stringify({ ...p.data.media, vertical: p.data.vertical, alt: p.data.title });
          return (
            <article
              class="ai-card"
              data-media={payload}
              data-reveal
              style={`--reveal-delay: ${i * 80}ms;`}
              tabindex="0"
              role="button"
              aria-label={`Play ${p.data.title}`}
            >
              <div class="ai-card-thumb">
                <img src={p.data.thumbnail} alt={p.data.title} loading="lazy" decoding="async" />
                <span class="ai-card-play"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span>
              </div>
              <div class="ai-card-meta">
                <span class="ai-card-num">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="ai-card-title">{p.data.title}</h3>
                {p.data.tagline && <p class="ai-card-blurb">{p.data.tagline}</p>}
              </div>
            </article>
          );
        })}
      </div>
    )}
  </div>
</section>

<style>
  .ailab {
    position: relative;
    padding-block: clamp(5rem, 12vw, 8rem);
    overflow: hidden;
    background: var(--bg);
    border-block: 1px solid var(--line);
  }
  .ailab-canvas {
    position: absolute; inset: 0;
    pointer-events: none;
    z-index: 0;
  }
  .ailab-grid {
    position: absolute; inset: 0;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 64px 64px;
    -webkit-mask-image: radial-gradient(ellipse at 70% 30%, black 0%, transparent 70%);
            mask-image: radial-gradient(ellipse at 70% 30%, black 0%, transparent 70%);
  }
  .ailab-glow {
    position: absolute; inset: -10%;
    background:
      radial-gradient(ellipse at 80% 20%, color-mix(in oklab, var(--accent-2) 22%, transparent), transparent 55%),
      radial-gradient(ellipse at 10% 80%, color-mix(in oklab, var(--accent) 18%, transparent), transparent 60%);
    filter: blur(60px);
    animation: drift 22s var(--ease-out-expo) infinite alternate;
  }
  .ailab-inner { position: relative; z-index: 1; }

  .ailab-head { max-width: 60rem; display: flex; flex-direction: column; gap: 1rem; margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .ailab-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.6rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }
  .ailab-title em { font-style: italic; color: var(--accent-2); }
  .ailab-lede { color: var(--fg-soft); max-width: 56ch; line-height: 1.6; }

  .ailab-cols {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }
  @media (min-width: 980px) { .ailab-cols { grid-template-columns: 1.2fr 1fr; gap: 3rem; } }

  .ailab-caps { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 1rem; }
  .ai-cap {
    display: grid;
    grid-template-columns: 36px 1fr;
    gap: 1rem;
    padding: 1.1rem 1.2rem;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--bg-elev);
  }
  .ai-cap-code {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    color: var(--accent-2);
    border: 1px solid var(--accent-2);
    border-radius: 6px;
    padding: 0.3rem 0.4rem;
    align-self: start;
    height: fit-content;
  }
  .ai-cap-title {
    font-family: var(--font-display);
    font-size: 1.1rem;
    margin: 0 0 0.25rem;
  }
  .ai-cap-body { color: var(--fg-soft); font-size: 0.92rem; line-height: 1.55; }

  .ailab-prompt {
    border: 1px solid var(--line-strong);
    border-radius: 14px;
    padding: 1.4rem 1.4rem 1.5rem;
    background: var(--bg-elev);
    display: flex; flex-direction: column; gap: 0.6rem;
    font-family: var(--font-mono);
    box-shadow: 0 10px 30px -20px color-mix(in oklab, var(--accent-2) 40%, transparent);
  }
  .ai-pl { font-size: 0.65rem; letter-spacing: 0.18em; color: var(--accent-2); }
  .ai-pt {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.1rem;
    line-height: 1.45;
    color: var(--fg);
  }
  .ai-pt em { color: var(--accent); font-style: italic; }
  .ai-pb { font-size: 0.7rem; color: var(--mute); letter-spacing: 0.12em; }

  .ailab-grid-cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.2rem;
  }
  @media (min-width: 700px) { .ailab-grid-cards { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .ailab-grid-cards { grid-template-columns: repeat(4, 1fr); } }

  .ai-card {
    position: relative;
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
    background: var(--bg-elev);
    cursor: pointer;
    transition: transform 0.5s var(--ease-out-expo), border-color 0.4s ease, box-shadow 0.4s ease;
    text-align: left;
  }
  .ai-card:hover { transform: translateY(-4px); border-color: var(--accent-2); box-shadow: 0 30px 60px -30px color-mix(in oklab, var(--accent-2) 40%, transparent); }
  .ai-card-thumb {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--bg);
    overflow: hidden;
  }
  .ai-card-thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform 1s var(--ease-out-expo); }
  .ai-card:hover .ai-card-thumb img { transform: scale(1.06); }
  .ai-card-play {
    position: absolute; bottom: 12px; right: 12px;
    width: 36px; height: 36px;
    display: grid; place-items: center;
    background: var(--accent-2); color: #fff;
    border-radius: 999px;
  }
  .ai-card-meta { padding: 1rem 1.1rem 1.2rem; display: flex; flex-direction: column; gap: 0.35rem; }
  .ai-card-num {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    color: var(--mute);
  }
  .ai-card-title {
    font-family: var(--font-display);
    font-size: 1.1rem;
    margin: 0;
  }
  .ai-card-blurb { color: var(--fg-soft); font-size: 0.88rem; line-height: 1.5; }
</style>
