---
import { SERVICES, SITE } from '@/lib/site';

interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<section
  id="services"
  class="relative py-24 sm:py-36 bg-cream-2/60 overflow-hidden grain"
>
  <div class="max-w-7xl mx-auto px-6 sm:px-10">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-8 mb-12 sm:mb-16">
      <div>
        <p class="font-mono text-xs tracking-[0.3em] text-ink-soft" data-reveal>
          // 02 · SERVICES &amp; PRICING
        </p>
        <h2
          class="mt-5 font-display leading-[0.95] tracking-tight text-balance"
          style="font-size: clamp(2.4rem, 7vw, 6.5rem);"
          data-reveal
        >
          Three productized offers,
          <br /><em class="not-italic text-coral">fixed scope</em>, fixed price.
        </h2>
      </div>
      <p class="max-w-md text-ink-soft text-pretty" data-reveal>
        Pick the offer that matches what you’re shipping. Each one has a defined deliverable, turnaround
        and revision cycle — so you know exactly what you’re getting before the kickoff call.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 sm:gap-7">
      {SERVICES.map((s, i) => (
        <article
          data-reveal
          style={`--reveal-delay:${i * 80}ms`}
          class:list={[
            'relative flex flex-col rounded-3xl border p-7 sm:p-8 transition-colors',
            s.badge
              ? 'border-coral/50 bg-paper shadow-[0_8px_40px_-20px_rgba(255,95,31,0.4)]'
              : 'border-ink/10 bg-paper hover:border-ink/25',
          ]}
        >
          {s.badge && (
            <span class="absolute -top-3 left-7 inline-flex items-center gap-1.5 rounded-full bg-coral text-cream text-[10px] tracking-[0.18em] uppercase font-mono px-3 py-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-cream animate-pulse"></span>
              {s.badge}
            </span>
          )}

          <header>
            <p class="font-mono text-[11px] tracking-[0.22em] uppercase text-ink-soft">
              {s.turnaround}
            </p>
            <h3 class="mt-3 font-display text-2xl sm:text-3xl leading-tight text-ink">
              {s.name}
            </h3>
            <div class="mt-4 flex items-baseline gap-2">
              <span class="font-display text-4xl sm:text-5xl text-ink leading-none">
                {s.price}
              </span>
              <span class="font-mono text-[11px] tracking-[0.15em] uppercase text-ink-soft">
                {s.cadence}
              </span>
            </div>
          </header>

          <p class="mt-5 text-ink-soft text-sm sm:text-base text-pretty">{s.pitch}</p>

          {!compact && (
            <>
              <p class="mt-6 font-mono text-[10px] tracking-[0.22em] uppercase text-ink-soft">
                For
              </p>
              <p class="mt-2 text-sm text-ink text-pretty">{s.forWho}</p>

              <ul class="mt-6 space-y-2.5 text-sm text-ink">
                {s.deliverables.map((d) => (
                  <li class="flex items-start gap-3">
                    <span aria-hidden="true" class="mt-2 inline-block w-1.5 h-1.5 rounded-full bg-coral shrink-0"></span>
                    <span class="text-pretty">{d}</span>
                  </li>
                ))}
              </ul>

              <p class="mt-6 font-mono text-[10px] tracking-[0.22em] uppercase text-ink-soft">
                Not included
              </p>
              <ul class="mt-2 space-y-1.5 text-xs text-ink-soft">
                {s.notIncluded.map((n) => (
                  <li class="flex items-start gap-2">
                    <span aria-hidden="true" class="mt-1.5 inline-block w-1 h-1 rounded-full bg-ink-soft/40 shrink-0"></span>
                    <span>{n}</span>
                  </li>
                ))}
              </ul>
            </>
          )}

          <div class="mt-auto pt-7">
            <a
              href={SITE.calendly}
              target="_blank"
              rel="noopener noreferrer"
              data-cursor-link
              class:list={[
                'group inline-flex w-full items-center justify-between gap-3 rounded-full px-5 py-3.5 text-sm font-medium transition-colors',
                s.badge
                  ? 'bg-coral text-cream hover:bg-ink'
                  : 'bg-ink text-cream hover:bg-coral',
              ]}
            >
              Book this engagement
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-1 transition-transform" aria-hidden="true">
                <path d="M5 12h14" />
                <path d="M13 5l7 7-7 7" />
              </svg>
            </a>
            <p class="mt-3 font-mono text-[10px] tracking-[0.18em] uppercase text-ink-soft text-center">
              {s.bestFor}
            </p>
          </div>
        </article>
      ))}
    </div>

    <p class="mt-12 text-center text-sm text-ink-soft text-pretty" data-reveal>
      Need something custom? Larger campaigns, multi-product launches and brand systems are quoted on a call. ·
      <a href={SITE.calendly} target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 decoration-coral/60 hover:text-ink">
        Book a call
      </a>
    </p>
  </div>
</section>
