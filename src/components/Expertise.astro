---
/**
 * Expertise — premium service cards.
 *
 * Surfaces the four offerings (Visual Design, AI, Filmmaking,
 * Editing/Motion) with tools and deliverables, plus copy that frames
 * how each service helps a client.
 */
import { SERVICES } from '@/lib/site';
---

<section id="expertise" class="expertise">
  <div class="wrap">
    <header class="expertise-head">
      <span class="eyebrow" data-reveal>What I do</span>
      <h2 class="expertise-title text-balance" data-reveal style="--reveal-delay: 80ms;">
        Services for brands ready to <em>look great</em> and <em>perform</em>.
      </h2>
      <p class="expertise-lede" data-reveal style="--reveal-delay: 160ms;">
        Pick one, mix two, take all four. Every engagement is built around
        clear deliverables, fast cycles and a creative direction that holds
        across film, motion, design and AI.
      </p>
    </header>

    <div class="expertise-grid">
      {SERVICES.map((s, i) => (
        <article class="srv" data-reveal style={`--reveal-delay: ${120 + i * 90}ms;`}>
          <div class="srv-top">
            <span class="srv-code">{s.code}</span>
            <h3 class="srv-title">{s.title}</h3>
          </div>
          <p class="srv-body">{s.body}</p>

          <div class="srv-grid">
            <div>
              <span class="srv-key">Tools</span>
              <ul class="srv-list">
                {s.tools.map((t) => <li>{t}</li>)}
              </ul>
            </div>
            <div>
              <span class="srv-key">Deliverables</span>
              <ul class="srv-list">
                {s.deliverables.map((t) => <li>{t}</li>)}
              </ul>
            </div>
          </div>

          <a href="#contact" class="srv-cta">
            Start a project
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17 17 7M9 7h8v8"/></svg>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .expertise {
    padding-block: clamp(5rem, 12vw, 8rem);
    position: relative;
  }
  .expertise-head {
    max-width: 60rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    display: flex; flex-direction: column; gap: 1.2rem;
  }
  .expertise-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.6rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }
  .expertise-title em { font-style: italic; color: var(--accent); }
  .expertise-lede { color: var(--fg-soft); max-width: 56ch; line-height: 1.6; }

  .expertise-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.2rem;
  }
  @media (min-width: 760px) { .expertise-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  .srv {
    position: relative;
    padding: 1.7rem 1.6rem 1.6rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--bg-elev);
    display: flex; flex-direction: column; gap: 1rem;
    transition: transform 0.5s var(--ease-out-expo), border-color 0.4s ease, box-shadow 0.4s ease;
    overflow: hidden;
  }
  .srv::before {
    content: "";
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    background: linear-gradient(135deg, color-mix(in oklab, var(--accent) 20%, transparent), transparent 60%);
    opacity: 0;
    transition: opacity 0.5s ease;
    pointer-events: none;
  }
  .srv:hover { transform: translateY(-6px); border-color: var(--line-strong); box-shadow: var(--shadow-card); }
  .srv:hover::before { opacity: 1; }
  .srv > * { position: relative; z-index: 1; }

  .srv-top { display: flex; align-items: baseline; gap: 1rem; }
  .srv-code {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--mute);
    letter-spacing: 0.1em;
  }
  .srv-title {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.4vw, 1.8rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
    margin: 0;
  }

  .srv-body { color: var(--fg-soft); line-height: 1.55; max-width: 60ch; }

  .srv-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.4rem;
    margin-top: 0.4rem;
  }
  .srv-key {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--mute);
    margin-bottom: 0.55rem;
  }
  .srv-list {
    list-style: none;
    margin: 0; padding: 0;
    display: flex; flex-direction: column; gap: 0.35rem;
    font-size: 0.92rem;
    color: var(--fg-soft);
  }

  .srv-cta {
    align-self: flex-start;
    margin-top: 0.4rem;
    display: inline-flex; align-items: center; gap: 0.4rem;
    padding: 0.65rem 0.9rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: 0.85rem;
    color: var(--fg);
    transition: background 0.3s ease, color 0.3s ease, border-color 0.3s ease;
  }
  .srv-cta:hover { background: var(--fg); color: var(--bg); border-color: var(--fg); }
</style>
