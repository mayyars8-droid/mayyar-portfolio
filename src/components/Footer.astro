---
import { SITE } from '@/lib/site';
const year = new Date().getFullYear();
---

<footer id="contact" class="relative bg-ink text-cream pt-28 pb-10 mt-12 overflow-hidden">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-40 left-1/2 -translate-x-1/2 h-[60vmin] w-[60vmin] rounded-full bg-coral blur-[140px] opacity-30">
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-6 sm:px-10">
    <p class="font-mono text-xs tracking-[0.3em] text-cream/55" data-reveal>
      // CONTACT
    </p>

    <h2
      class="font-display text-[clamp(2.6rem,7vw,7rem)] leading-[0.95] tracking-tight mt-6 max-w-5xl"
      data-reveal
    >
      Ship the next campaign in <em class="not-italic text-coral">days</em>,
      not weeks. Book a 20-minute call.
    </h2>

    <p class="mt-6 max-w-2xl text-cream/70 text-base sm:text-lg text-pretty" data-reveal>
      I’ll diagnose where your visuals are leaking budget and walk you through a fixed-price plan to fix it.
      No pitch deck. No agency upsell.
    </p>

    <div class="mt-10 flex flex-wrap items-center gap-4" data-reveal>
      <a
        href={SITE.calendly}
        target="_blank"
        rel="noopener noreferrer"
        data-cursor-link
        class="group inline-flex items-center gap-3 rounded-full bg-coral text-ink px-7 py-4 text-base font-medium hover:bg-cream transition-colors"
      >
        Book a 20-min call
        <span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-ink text-cream group-hover:rotate-45 transition-transform">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14" />
            <path d="M13 5l7 7-7 7" />
          </svg>
        </span>
      </a>

      <a
        href={SITE.social.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        data-cursor-link
        class="inline-flex items-center gap-2 rounded-full border border-cream/25 px-5 py-4 text-sm hover:bg-cream/10 transition-colors"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
        </svg>
        LinkedIn
      </a>

      <a
        href={SITE.social.whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        data-cursor-link
        class="inline-flex items-center gap-2 rounded-full border border-cream/25 px-5 py-4 text-sm hover:bg-cream/10 transition-colors"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
        </svg>
        WhatsApp
      </a>
    </div>

    <div class="mt-20 flex flex-col-reverse sm:flex-row sm:items-end justify-between gap-6 border-t border-cream/15 pt-8 text-cream/55 text-sm font-mono">
      <p>© {year} {SITE.author}. Directed by Mayyar.</p>
      <p>Built with Astro · React · Three.js · Tailwind</p>
    </div>
  </div>
</footer>
