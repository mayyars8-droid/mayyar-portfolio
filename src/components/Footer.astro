---
/**
 * Site footer. Minimal but elegant.
 */
import { SITE } from '@/lib/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap-wide footer-inner">
    <div class="foot-brand">
      <a href="#top" class="brand">
        <span class="brand-mark">M</span>
        <span class="brand-name">Mayyar<span class="brand-dot">.</span></span>
      </a>
      <p class="foot-tag">{SITE.tagline}</p>
    </div>

    <div class="foot-cols">
      <div>
        <span class="fc-key">Sections</span>
        <ul>
          <li><a href="#vision">Vision</a></li>
          <li><a href="#expertise">Expertise</a></li>
          <li><a href="#work">Work</a></li>
          <li><a href="#reel">Reel</a></li>
          <li><a href="#ai-lab">AI Lab</a></li>
          <li><a href="#process">Process</a></li>
          <li><a href="#experience">Experience</a></li>
          <li><a href="#contact">Contact</a></li>
        </ul>
      </div>
      <div>
        <span class="fc-key">Connect</span>
        <ul>
          <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
          <li><a href={SITE.social.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
          <li><a href={SITE.social.whatsapp} target="_blank" rel="noopener">WhatsApp</a></li>
          <li><a href={SITE.social.linktree} target="_blank" rel="noopener">Linktree</a></li>
          <li><a href={SITE.resumeHref} download>Download CV</a></li>
        </ul>
      </div>
    </div>
  </div>

  <div class="wrap-wide foot-bottom">
    <span class="fb-copy">© {year} {SITE.author}. Crafted with care in {SITE.location}.</span>
    <a href="#top" class="fb-top" aria-label="Back to top">
      Back to top
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 19V5m-7 7 7-7 7 7"/></svg>
    </a>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--bg);
    border-top: 1px solid var(--line);
    padding-top: 4rem;
  }
  .footer-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    padding-bottom: 3rem;
  }
  @media (min-width: 760px) { .footer-inner { grid-template-columns: 1.2fr 1fr; gap: 4rem; align-items: start; } }

  .brand {
    display: inline-flex; align-items: center; gap: 0.65rem;
    font-family: var(--font-display); font-size: 1.2rem;
  }
  .brand-mark {
    width: 34px; height: 34px;
    border-radius: 8px;
    background: var(--fg);
    color: var(--bg);
    display: grid; place-items: center; font-weight: 700; font-size: 16px;
  }
  .brand-dot { color: var(--accent); }

  .foot-tag { color: var(--fg-soft); margin-top: 0.6rem; max-width: 32ch; }

  .foot-cols {
    display: grid; grid-template-columns: 1fr 1fr; gap: 2rem;
  }
  .fc-key {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--mute);
    margin-bottom: 0.8rem; display: block;
  }
  .foot-cols ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.45rem; }
  .foot-cols a { color: var(--fg-soft); transition: color 0.3s ease; }
  .foot-cols a:hover { color: var(--accent); }

  .foot-bottom {
    display: flex; justify-content: space-between; align-items: center;
    padding-block: 1.2rem;
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--mute);
    flex-wrap: wrap; gap: 0.6rem;
  }
  .fb-top { display: inline-flex; align-items: center; gap: 0.4rem; color: var(--fg-soft); transition: color 0.3s ease; }
  .fb-top:hover { color: var(--accent); }
</style>
