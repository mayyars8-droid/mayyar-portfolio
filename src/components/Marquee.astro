---
/**
 * Endless-scrolling credits strip — adds energy without screen weight.
 */
import { MARQUEE } from '@/lib/site';
const items = [...MARQUEE, ...MARQUEE];
---

<section class="marquee-section" aria-hidden="true">
  <div class="ticker-mask">
    <div class="marquee-track">
      {items.map((label) => (
        <span class="m-item">
          <span>{label}</span>
          <span class="m-dot">✦</span>
        </span>
      ))}
    </div>
  </div>
</section>

<style>
  .marquee-section {
    padding-block: 1.2rem;
    border-block: 1px solid var(--line);
    background: var(--bg-elev);
    overflow: hidden;
  }
  .marquee-track {
    display: inline-flex;
    gap: 2.4rem;
    white-space: nowrap;
    will-change: transform;
  }
  .m-item {
    display: inline-flex;
    align-items: center;
    gap: 2.4rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.4rem, 3vw, 2.4rem);
    color: var(--fg);
    font-weight: 400;
  }
  .m-dot { color: var(--accent); }
</style>
