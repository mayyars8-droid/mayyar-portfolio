---
/**
 * Experience — CV timeline (work + education) plus tools/skills.
 *
 * Pulls from the `experience` content collection. The CV download
 * button at the bottom reuses the SITE.resumeHref from /public.
 */
import { getCollection } from 'astro:content';
import { SITE } from '@/lib/site';

const all = await getCollection('experience');
const work = all.filter((e) => e.data.type === 'experience').sort((a, b) => (b.data.order ?? 0) - (a.data.order ?? 0));
const education = all.filter((e) => e.data.type === 'education').sort((a, b) => (b.data.order ?? 0) - (a.data.order ?? 0));

const skills = [
  'Visual Design', 'Brand Identity', 'Editorial Layout',
  'AI Workflows', 'Generative Imaging', 'Prompt Direction',
  'Cinematography', 'Direction', 'Storyboarding',
  'Editing', 'Color Grading', 'Sound Design',
  'Motion Graphics', 'Kinetic Typography',
  'Social Media Strategy', 'Content Production',
];

const tools = [
  'Adobe Photoshop', 'Illustrator', 'InDesign', 'Lightroom',
  'After Effects', 'Premiere Pro', 'DaVinci Resolve',
  'Figma', 'Midjourney', 'Runway', 'ComfyUI', 'GPT',
];
---

<section id="experience" class="experience">
  <div class="wrap">
    <header class="experience-head">
      <span class="eyebrow" data-reveal>Experience · The track record</span>
      <h2 class="experience-title text-balance" data-reveal style="--reveal-delay: 80ms;">
        Five years of building, shipping and learning in public.
      </h2>
    </header>

    <div class="experience-cols">
      <div class="exp-col">
        <h3 class="exp-col-title">Work</h3>
        <ol class="timeline" role="list">
          {work.map((e, i) => (
            <li class="timeline-item" data-reveal style={`--reveal-delay: ${i * 70}ms;`}>
              <div class="exp-meta">
                <span class="exp-period">{e.data.period}</span>
                {e.data.location && <span class="exp-loc">· {e.data.location}</span>}
                {e.data.employment && <span class="exp-emp">· {e.data.employment}</span>}
              </div>
              <h4 class="exp-role">{e.data.role}</h4>
              <p class="exp-company">{e.data.company}</p>
              {e.data.award && <p class="exp-award">{e.data.award}</p>}
              {e.body && <p class="exp-desc">{e.body}</p>}
            </li>
          ))}
        </ol>
      </div>

      <div class="exp-col">
        <h3 class="exp-col-title">Education</h3>
        <ol class="timeline" role="list">
          {education.map((e, i) => (
            <li class="timeline-item" data-reveal style={`--reveal-delay: ${i * 70}ms;`}>
              <div class="exp-meta">
                <span class="exp-period">{e.data.period}</span>
                {e.data.location && <span class="exp-loc">· {e.data.location}</span>}
              </div>
              <h4 class="exp-role">{e.data.role}</h4>
              <p class="exp-company">{e.data.company}</p>
              {e.data.award && <p class="exp-award">{e.data.award}</p>}
              {e.body && <p class="exp-desc">{e.body}</p>}
            </li>
          ))}
        </ol>

        <div class="exp-block" data-reveal>
          <h4 class="exp-block-title">Skills</h4>
          <div class="exp-tags">
            {skills.map((s) => <span class="exp-tag">{s}</span>)}
          </div>
        </div>

        <div class="exp-block" data-reveal>
          <h4 class="exp-block-title">Tools</h4>
          <div class="exp-tags">
            {tools.map((s) => <span class="exp-tag mono">{s}</span>)}
          </div>
        </div>

        <div class="exp-block" data-reveal>
          <h4 class="exp-block-title">Languages</h4>
          <div class="exp-tags">
            <span class="exp-tag">Arabic — Native</span>
            <span class="exp-tag">English — Proficient</span>
          </div>
        </div>
      </div>
    </div>

    <div class="experience-cv" data-reveal>
      <div>
        <span class="cv-label">Want the full document?</span>
        <p class="cv-body">Download the latest CV (PDF) — résumé, references and detailed project history.</p>
      </div>
      <a href={SITE.resumeHref} class="btn btn-primary" download>
        Download CV (PDF)
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v14m-6-6 6 6 6-6M5 21h14"/></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .experience {
    padding-block: clamp(5rem, 12vw, 8rem);
  }
  .experience-head { max-width: 60rem; margin-bottom: clamp(2.5rem, 5vw, 4rem); display: flex; flex-direction: column; gap: 1rem; }
  .experience-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.6rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }

  .experience-cols {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }
  @media (min-width: 980px) { .experience-cols { grid-template-columns: 1fr 1fr; gap: 4rem; } }

  .exp-col { display: flex; flex-direction: column; gap: 1.4rem; }
  .exp-col-title {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--mute);
  }

  .timeline { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 1.6rem; }
  .timeline-item { padding-bottom: 1.4rem; }
  .exp-meta { display: flex; flex-wrap: wrap; gap: 0.4rem; font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.06em; color: var(--mute); }
  .exp-period { color: var(--accent); }
  .exp-role {
    font-family: var(--font-display);
    font-size: 1.2rem;
    margin: 0.4rem 0 0.2rem;
    line-height: 1.2;
  }
  .exp-company { color: var(--fg-soft); margin: 0; }
  .exp-award {
    margin-top: 0.5rem;
    padding: 0.4rem 0.7rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    font-size: 0.85rem;
    color: var(--fg-soft);
    display: inline-block;
  }
  .exp-desc {
    margin-top: 0.6rem;
    color: var(--fg-soft);
    font-size: 0.92rem;
    line-height: 1.55;
    max-width: 50ch;
    text-wrap: pretty;
  }

  .exp-block { margin-top: 1rem; display: flex; flex-direction: column; gap: 0.7rem; }
  .exp-block-title {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--mute);
    margin: 0;
  }
  .exp-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .exp-tag {
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.85rem;
    color: var(--fg-soft);
    background: var(--bg-elev);
  }
  .exp-tag.mono {
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .experience-cv {
    margin-top: 3rem;
    padding: 1.6rem 1.8rem;
    border: 1px solid var(--line-strong);
    border-radius: 16px;
    background: var(--bg-elev);
    display: flex; align-items: center; justify-content: space-between;
    gap: 1.5rem; flex-wrap: wrap;
  }
  .cv-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.4rem;
    display: block;
  }
  .cv-body { color: var(--fg-soft); margin: 0; max-width: 50ch; }
</style>
