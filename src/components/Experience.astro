---
import { getCollection } from 'astro:content';

const items = (await getCollection('experience'))
  .sort((a, b) => (b.data.order ?? 0) - (a.data.order ?? 0));

const experience = items.filter((i) => i.data.type === 'experience');
const education = items.filter((i) => i.data.type === 'education');
---

<section
  id="experience"
  class="relative py-24 sm:py-36 bg-paper overflow-hidden"
>
  <div class="max-w-7xl mx-auto px-6 sm:px-10">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-8 mb-14">
      <div>
        <p class="font-mono text-xs tracking-[0.3em] text-ink-soft" data-reveal>
          // 06 · PRODUCTION LOG
        </p>
        <h2
          class="mt-5 font-display leading-[0.95] tracking-tight text-balance"
          style="font-size: clamp(2.4rem, 7vw, 6rem);"
          data-reveal
        >
          Experience &amp; <em class="not-italic text-coral">education</em>.
        </h2>
      </div>
      <p class="max-w-md text-ink-soft text-pretty" data-reveal>
        A career bridging visual design, filmmaking and digital marketing —
        translating strategy into work that travels.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-12">
      <div class="md:col-span-8">
        <h3 class="font-mono text-[11px] tracking-[0.25em] uppercase text-ink-soft mb-6">
          Experience
        </h3>
        <ol class="relative pl-6 sm:pl-8 border-l border-ink/15 space-y-10">
          {experience.map((item, i) => (
            <li class="relative" data-reveal style={`--reveal-delay:${i * 50}ms`}>
              <span
                aria-hidden="true"
                class="absolute -left-[33px] sm:-left-[37px] top-2 w-3 h-3 rounded-full bg-coral ring-4 ring-paper"
              ></span>
              <p class="font-mono text-[11px] tracking-[0.2em] uppercase text-ink-soft">
                {item.data.period}{item.data.location ? ` · ${item.data.location}` : ''}{item.data.employment ? ` · ${item.data.employment}` : ''}
              </p>
              <h4 class="mt-2 font-display text-2xl sm:text-3xl leading-tight">
                {item.data.role}
              </h4>
              <p class="mt-1 text-ink-soft">{item.data.company}</p>
              {item.body && (
                <p class="mt-3 max-w-2xl text-ink-soft/90 text-pretty">
                  {item.body}
                </p>
              )}
            </li>
          ))}
        </ol>
      </div>

      <div class="md:col-span-4 space-y-10" data-reveal>
        <div>
          <h3 class="font-mono text-[11px] tracking-[0.25em] uppercase text-ink-soft mb-6">
            Education
          </h3>
          {education.map((item) => (
            <div class="rounded-3xl border border-ink/10 bg-cream-2/40 p-6">
              <p class="font-mono text-[11px] tracking-[0.2em] uppercase text-ink-soft">
                {item.data.period}
              </p>
              <h4 class="mt-2 font-display text-xl leading-tight">
                {item.data.role}
              </h4>
              <p class="mt-1 text-ink-soft">{item.data.company}</p>
              {item.data.award && (
                <p class="mt-4 inline-flex items-center gap-2 rounded-full bg-coral text-cream px-3 py-1.5 text-xs font-medium">
                  <span aria-hidden="true">★</span>
                  {item.data.award}
                </p>
              )}
            </div>
          ))}
        </div>

        <div>
          <h3 class="font-mono text-[11px] tracking-[0.25em] uppercase text-ink-soft mb-6">
            Languages
          </h3>
          <div class="grid grid-cols-2 gap-4">
            <div class="rounded-2xl border border-ink/10 bg-paper p-5">
              <p class="font-display text-lg">Arabic</p>
              <p class="font-mono text-[11px] tracking-[0.2em] uppercase text-ink-soft mt-1">
                Native
              </p>
            </div>
            <div class="rounded-2xl border border-ink/10 bg-paper p-5">
              <p class="font-display text-lg">English</p>
              <p class="font-mono text-[11px] tracking-[0.2em] uppercase text-ink-soft mt-1">
                Proficient
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
