---
/**
 * Single project card. Renders a thumbnail and metadata.
 * Clicking opens the lightbox via [data-media] payload (handled in BaseLayout).
 */
type MediaPayload =
  | { type: 'youtube'; src: string; poster?: string }
  | { type: 'image'; src: string; alt?: string }
  | { type: 'video'; src: string; poster?: string }
  | { type: 'gallery'; images: { src: string; alt?: string }[] };

interface Props {
  title: string;
  category: string;
  tagline?: string;
  year?: number;
  thumbnail: string;
  media: MediaPayload;
  vertical?: boolean;
  external?: string;
  tags?: string[];
}

const {
  title,
  category,
  tagline,
  year,
  thumbnail,
  media,
  vertical = false,
  external,
  tags = [],
} = Astro.props;

// Galleries open as a single image (first one) for now.
const lightboxMedia =
  media.type === 'gallery'
    ? { type: 'image' as const, src: media.images[0]?.src ?? thumbnail, alt: title }
    : media;
const payload = JSON.stringify({ ...lightboxMedia, vertical, alt: title });
const labelMap: Record<string, string> = {
  film: 'Film',
  editing: 'Editing',
  motion: 'Motion',
  content: 'Content',
  design: 'Design',
  ai: 'AI Lab',
};
const isVideo = lightboxMedia.type === 'youtube' || lightboxMedia.type === 'video';
---

<article
  class={`project-card${vertical ? ' vertical' : ''}`}
  data-category={category}
  data-media={payload}
  tabindex="0"
  role="button"
  aria-label={`Open project: ${title}`}
>
  <div class="thumb">
    <img src={thumbnail} alt={title} loading="lazy" decoding="async" />
    {isVideo && (
      <span class="play" aria-hidden="true">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
      </span>
    )}
  </div>
  <div class="meta">
    <div class="row">
      <span>{labelMap[category] ?? category}</span>
      <span>{year ?? ''}</span>
    </div>
    <h3 class="title">{title}</h3>
    {tagline && <p class="tagline">{tagline}</p>}
    {(tags.length > 0 || external) && (
      <div class="tagrow">
        {tags.slice(0, 3).map((t) => <span class="tg">{t}</span>)}
        {external && (
          <a class="ext" href={external} target="_blank" rel="noopener" onclick="event.stopPropagation()">
            Open ↗
          </a>
        )}
      </div>
    )}
  </div>
</article>

<style>
  .tagrow {
    display: flex; flex-wrap: wrap; gap: 0.35rem;
    margin-top: 0.35rem;
  }
  .tg {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--mute);
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--line);
    border-radius: 999px;
  }
  .ext {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-left: auto;
  }
  .ext:hover { text-decoration: underline; }
</style>
