---
import { SITE } from '@/lib/site';

const why = [
  {
    title: 'Productized pricing',
    body: 'Fixed scopes, fixed prices, fixed turnarounds. No “let me get back to you” quotes.',
  },
  {
    title: '3–5 day delivery',
    body: 'Most projects are in your inbox before a studio quote would even land.',
  },
  {
    title: 'AI + human polish',
    body: 'Generative tools accelerate iteration. Photoshop, After Effects and Premiere do the finishing.',
  },
];
---

<section id="why" class="relative py-20 sm:py-28 overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 sm:px-10">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 items-center">
      <div class="md:col-span-7 lg:col-span-7" data-reveal>
        <p class="font-mono text-xs tracking-[0.3em] text-ink-soft">
          // 01 · WHY HIRE ME
        </p>
        <h2
          class="mt-6 font-display leading-[0.95] tracking-tight text-balance"
          style="font-size: clamp(2rem, 5.6vw, 5rem);"
        >
          <span class="block">A studio shoot.</span>
          <span class="block">
            A <em class="not-italic text-coral">paid ad creative team.</em>
          </span>
          <span class="block">One AI-native operator.</span>
        </h2>
        <p class="mt-8 max-w-2xl text-ink-soft text-base sm:text-lg text-pretty">
          DTC brands and SaaS startups hire me when they need ad-ready product visuals without booking a photographer,
          renting a studio, casting models or waiting six weeks for an agency revision cycle.
          I run the full stack — direction, generation, design, motion, polish — and deliver in days.
        </p>

        <div class="mt-10 grid grid-cols-1 sm:grid-cols-3 gap-6">
          {why.map((w) => (
            <div class="rounded-2xl border border-ink/10 bg-paper/70 p-5">
              <p class="font-display text-lg leading-tight text-ink">{w.title}</p>
              <p class="mt-2 text-sm text-ink-soft text-pretty">{w.body}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="md:col-span-5 lg:col-span-5 relative" data-reveal>
        <div class="relative aspect-[4/5] overflow-hidden rounded-3xl border border-ink/10 bg-cream-2">
          <img
            src={SITE.portrait}
            alt="Mayyar Al-Sharqawi"
            class="absolute inset-0 w-full h-full object-cover"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-ink/20 via-transparent to-transparent"></div>

          <div class="absolute bottom-4 left-4 right-4 flex items-center justify-between text-cream font-mono text-[11px] tracking-[0.2em] uppercase">
            <span>Mayyar Al-Sharqawi</span>
            <span>Amman · Jordan</span>
          </div>
        </div>

        <div
          class="absolute -top-5 -right-5 sm:-top-7 sm:-right-7 w-24 h-24 sm:w-28 sm:h-28 rounded-full bg-coral text-cream flex items-center justify-center"
          aria-hidden="true"
        >
          <svg viewBox="0 0 100 100" class="absolute inset-0 spin-slow">
            <defs>
              <path id="circlePath" d="M 50,50 m -38,0 a 38,38 0 1,1 76,0 a 38,38 0 1,1 -76,0" />
            </defs>
            <text class="font-mono uppercase" font-size="9" letter-spacing="2" fill="currentColor">
              <textPath href="#circlePath">Available for work · Available for work · </textPath>
            </text>
          </svg>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14" />
            <path d="M13 5l7 7-7 7" />
          </svg>
        </div>

        <div class="absolute -bottom-5 -left-5 sm:-bottom-7 sm:-left-7 bg-paper border border-ink/10 rounded-2xl px-5 py-4 shadow-lg max-w-[230px]">
          <p class="font-mono text-[10px] tracking-[0.2em] uppercase text-ink-soft">Award</p>
          <p class="mt-1 font-display text-base leading-snug">
            Top Student of the Batch — Ranked 1st <span class="text-coral">JUST</span>
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
