---
/**
 * Cinematic hero — first frame of the experience.
 *
 * The hero communicates: who Mayyar is, what he does, and how to act.
 * Layered atmosphere (gradient + grid + grain) keeps it alive but light.
 */
import { ROLES, SITE } from '@/lib/site';
const rolesData = (ROLES as readonly string[]).join('|');
---

<section id="top" class="hero grain" aria-label="Hero">
  <div class="atmosphere"></div>
  <div class="grid-overlay" aria-hidden="true"></div>

  <div class="wrap hero-inner">
    <div class="hero-tag" data-reveal>
      <span class="dot"></span>
      <span>Available for select projects · {SITE.location}</span>
    </div>

    <h1 class="hero-headline text-balance" data-reveal style="--reveal-delay: 80ms;">
      <span class="line-1">Cinematic stories,</span>
      <span class="line-2"><em>intelligent</em> visuals</span>
      <span class="line-3">crafted by a <span class="role-rotator" data-rotator data-roles={rolesData}><span>Visual Designer</span></span></span>
    </h1>

    <p class="hero-lede text-pretty" data-reveal style="--reveal-delay: 200ms;">
      I'm <strong>Mayyar Al-Sharqawi</strong> — a multidisciplinary creative blending
      visual design, AI-driven workflows, filmmaking and motion editing into work
      that doesn't just look great, it <em>performs</em>.
    </p>

    <div class="hero-actions" data-reveal style="--reveal-delay: 280ms;">
      <a href="#work" class="btn btn-primary">
        View Work
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m5 12 14 0M13 5l7 7-7 7"/></svg>
      </a>
      <a href="#contact" class="btn btn-ghost">Contact</a>
      <a href={SITE.resumeHref} class="btn btn-ghost" download>
        Download CV
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v14m-6-6 6 6 6-6M5 21h14"/></svg>
      </a>
    </div>

    <div class="hero-strip" data-reveal style="--reveal-delay: 360ms;">
      <div class="hero-strip-cell">
        <span class="num">100<small>%</small></span>
        <span class="lab">Job Success<br/>on Upwork</span>
      </div>
      <div class="hero-strip-cell">
        <span class="num">300<small>+</small></span>
        <span class="lab">Posts shipped<br/>across brands</span>
      </div>
      <div class="hero-strip-cell">
        <span class="num">4<small>+</small></span>
        <span class="lab">Disciplines<br/>under one roof</span>
      </div>
      <div class="hero-strip-cell">
        <span class="num">5<small>yrs</small></span>
        <span class="lab">Freelance<br/>experience</span>
      </div>
    </div>

    <div class="hero-scrolldown" aria-hidden="true">
      <span class="line"></span>
      <span class="label">Scroll</span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(5rem, 14vh, 9rem) clamp(4rem, 10vh, 6rem);
    isolation: isolate;
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
    text-align: left;
  }

  .hero-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    align-self: start;
    padding: 0.4rem 0.9rem 0.4rem 0.65rem;
    border: 1px solid var(--line-strong);
    background: var(--surface);
    border-radius: 999px;
    font-size: 0.78rem;
    color: var(--fg-soft);
    letter-spacing: 0.02em;
  }
  .hero-tag .dot {
    width: 8px; height: 8px; border-radius: 999px;
    background: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--accent) 30%, transparent);
  }

  .hero-headline {
    font-family: var(--font-display);
    font-size: clamp(2.3rem, 8vw, 6rem);
    line-height: 0.97;
    letter-spacing: -0.035em;
    font-weight: 400;
    margin: 0.4rem 0 0;
    max-width: 18ch;
  }
  .hero-headline .line-1 { display: block; }
  .hero-headline .line-2 {
    display: block;
    font-style: italic;
    color: var(--fg-soft);
  }
  .hero-headline .line-2 em {
    font-style: italic;
    color: var(--accent-2);
    background: linear-gradient(110deg, var(--accent-2), var(--accent));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .hero-headline .line-3 {
    display: block;
    font-size: clamp(1.6rem, 5vw, 3.2rem);
    margin-top: 0.4rem;
    color: var(--fg);
    font-family: var(--font-sans);
    font-weight: 300;
    letter-spacing: -0.02em;
  }

  .hero-lede {
    max-width: 56ch;
    color: var(--fg-soft);
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    line-height: 1.55;
  }
  .hero-lede strong {
    color: var(--fg);
    font-weight: 600;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.4rem;
  }

  .hero-strip {
    margin-top: clamp(2.5rem, 6vw, 4rem);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: 16px;
    overflow: hidden;
  }
  @media (min-width: 760px) {
    .hero-strip { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  .hero-strip-cell {
    background: var(--bg-elev);
    padding: 1.2rem 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .hero-strip-cell .num {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--fg);
  }
  .hero-strip-cell .num small {
    font-size: 0.5em;
    color: var(--accent);
    margin-left: 0.2rem;
    font-weight: 400;
  }
  .hero-strip-cell .lab {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--mute);
    line-height: 1.4;
  }

  .hero-scrolldown {
    position: absolute;
    right: clamp(20px, 4vw, 56px);
    bottom: clamp(20px, 4vh, 40px);
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--mute);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .hero-scrolldown .line {
    display: block;
    width: 30px;
    height: 1px;
    background: var(--mute);
    animation: scrollLine 2s var(--ease-out-expo) infinite;
  }
  @keyframes scrollLine {
    0%, 100% { transform: scaleX(0.4); transform-origin: left; opacity: 0.4; }
    50%      { transform: scaleX(1);   transform-origin: left; opacity: 1; }
  }
  @media (max-width: 760px) {
    .hero-scrolldown { display: none; }
  }

  /* The role rotator span is positioned inline; we let JS swap text */
  .hero-headline .role-rotator span {
    background: linear-gradient(110deg, var(--accent), var(--accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }
</style>
