---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/lib/site';

export async function getStaticPaths() {
  const studies = await getCollection('caseStudies');
  return studies.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

type Props = { entry: CollectionEntry<'caseStudies'> };
const { entry } = Astro.props as Props;
const { Content } = await render(entry);
const data = entry.data;
---

<BaseLayout
  title={`${data.client} — ${data.title}`}
  description={data.summary}
>
  <article class="relative pb-24">
    <header class="relative pt-32 sm:pt-44 pb-16 sm:pb-24 overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-cream via-paper to-cream-2"></div>
      <div
        aria-hidden="true"
        class="pointer-events-none absolute -top-[10vmin] -right-[10vmin] h-[60vmin] w-[60vmin] rounded-full bg-coral/25 blur-[140px]"
      ></div>

      <div class="relative max-w-5xl mx-auto px-6 sm:px-10">
        <a
          href="/#case-studies"
          data-cursor-link
          class="inline-flex items-center gap-2 text-sm text-ink-soft hover:text-ink"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M19 12H5" />
            <path d="M12 19l-7-7 7-7" />
          </svg>
          All case studies
        </a>

        <p class="mt-10 font-mono text-xs tracking-[0.3em] text-ink-soft">
          // CASE STUDY · {data.category.toUpperCase()}
        </p>

        <h1
          class="mt-5 font-display leading-[0.95] tracking-tight text-balance"
          style="font-size: clamp(2.2rem, 6vw, 5.2rem);"
        >
          {data.title}
        </h1>

        <p class="mt-6 max-w-2xl text-ink-soft text-base sm:text-lg text-pretty">
          {data.summary}
        </p>

        <div class="mt-10 flex flex-wrap items-center gap-2">
          <span class="inline-flex items-center gap-2 rounded-full bg-ink text-cream font-mono text-[10px] tracking-[0.22em] uppercase px-3 py-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-coral"></span>
            {data.service}
          </span>
          <span class="inline-flex items-center gap-2 rounded-full border border-ink/15 bg-paper font-mono text-[10px] tracking-[0.22em] uppercase px-3 py-1.5 text-ink">
            {data.duration}
          </span>
          {data.spec && (
            <span class="inline-flex items-center gap-2 rounded-full border border-coral/40 bg-coral/10 text-coral font-mono text-[10px] tracking-[0.22em] uppercase px-3 py-1.5">
              Spec project
            </span>
          )}
        </div>
      </div>
    </header>

    <div class="relative max-w-5xl mx-auto px-6 sm:px-10">
      <div class="relative aspect-[16/9] sm:aspect-[2/1] overflow-hidden rounded-[2rem] sm:rounded-[2.5rem] border border-ink/10 bg-cream-2">
        <img
          src={data.cover}
          alt={data.title}
          class="absolute inset-0 w-full h-full object-cover"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>

    <section class="relative max-w-5xl mx-auto px-6 sm:px-10 mt-16 sm:mt-24 grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-16">
      <div class="md:col-span-2 space-y-12">
        <div>
          <p class="font-mono text-[10px] tracking-[0.25em] uppercase text-coral">
            Problem
          </p>
          <p class="mt-3 font-display text-xl sm:text-2xl leading-snug text-ink text-pretty">
            {data.problem}
          </p>
        </div>

        <div>
          <p class="font-mono text-[10px] tracking-[0.25em] uppercase text-coral">
            Approach
          </p>
          <p class="mt-3 text-ink-soft text-base sm:text-lg leading-relaxed text-pretty">
            {data.approach}
          </p>
        </div>

        <div>
          <p class="font-mono text-[10px] tracking-[0.25em] uppercase text-coral">
            Process
          </p>
          <ol class="mt-5 relative pl-6 sm:pl-8 border-l border-ink/15 space-y-7">
            {data.process.map((p, i) => (
              <li class="relative">
                <span
                  aria-hidden="true"
                  class="absolute -left-[33px] sm:-left-[37px] top-2 w-3 h-3 rounded-full bg-coral ring-4 ring-cream"
                ></span>
                <p class="font-mono text-[11px] tracking-[0.2em] uppercase text-ink-soft">
                  {String(i + 1).padStart(2, '0')} · {p.step}
                </p>
                <p class="mt-2 text-ink text-base text-pretty">{p.detail}</p>
              </li>
            ))}
          </ol>
        </div>

        {data.gallery && data.gallery.length > 0 && (
          <div>
            <p class="font-mono text-[10px] tracking-[0.25em] uppercase text-coral">
              Selected frames
            </p>
            <div class="mt-5 grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
              {data.gallery.map((g) => (
                <figure class="space-y-3">
                  <div class="aspect-[4/5] overflow-hidden rounded-2xl border border-ink/10 bg-cream-2">
                    <img
                      src={g.src}
                      alt={g.alt ?? data.title}
                      class="w-full h-full object-cover"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  {g.caption && (
                    <figcaption class="font-mono text-[11px] tracking-[0.18em] uppercase text-ink-soft">
                      {g.caption}
                    </figcaption>
                  )}
                </figure>
              ))}
            </div>
          </div>
        )}

        <div class="prose prose-neutral max-w-none text-ink-soft text-pretty">
          <Content />
        </div>
      </div>

      <aside class="md:col-span-1 space-y-8 md:sticky md:top-32 self-start">
        <div class="rounded-3xl border border-ink/10 bg-paper p-6 sm:p-7">
          <p class="font-mono text-[10px] tracking-[0.25em] uppercase text-ink-soft">
            Outcome
          </p>
          <ul class="mt-4 space-y-4">
            {data.outcome.map((o) => (
              <li>
                <p class="font-mono text-[10px] tracking-[0.18em] uppercase text-ink-soft">
                  {o.label}
                </p>
                <p class="mt-1 font-display text-xl leading-tight text-ink">
                  {o.value}
                </p>
              </li>
            ))}
          </ul>
        </div>

        <div class="rounded-3xl border border-ink/10 bg-cream-2/40 p-6 sm:p-7">
          <p class="font-mono text-[10px] tracking-[0.25em] uppercase text-ink-soft">
            Deliverables
          </p>
          <ul class="mt-4 space-y-2 text-sm text-ink">
            {data.deliverables.map((d) => (
              <li class="flex items-start gap-2.5">
                <span aria-hidden="true" class="mt-2 w-1.5 h-1.5 rounded-full bg-coral shrink-0"></span>
                <span class="text-pretty">{d}</span>
              </li>
            ))}
          </ul>
        </div>

        <a
          href={SITE.calendly}
          target="_blank"
          rel="noopener noreferrer"
          data-cursor-link
          class="block w-full text-center rounded-full bg-ink text-cream px-6 py-4 text-base font-medium hover:bg-coral transition-colors"
        >
          Book a similar engagement
        </a>
      </aside>
    </section>

    {data.testimonial && (
      <section class="relative max-w-5xl mx-auto px-6 sm:px-10 mt-20 sm:mt-28">
        <figure class="rounded-3xl border border-ink/10 bg-paper p-8 sm:p-12">
          <svg class="w-9 h-9 text-coral" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M9.6 6c-3.3 0-6 2.4-6 5.4v6.6h6v-6.6H6c0-2 1.6-3.4 3.6-3.4V6zm10.8 0c-3.3 0-6 2.4-6 5.4v6.6h6v-6.6h-3.6c0-2 1.6-3.4 3.6-3.4V6z" />
          </svg>
          <blockquote class="mt-5 font-display text-xl sm:text-2xl leading-snug text-ink text-pretty">
            “{data.testimonial.quote}”
          </blockquote>
          <figcaption class="mt-6 pt-6 border-t border-ink/10">
            <p class="font-display text-lg text-ink">{data.testimonial.author}</p>
            {data.testimonial.role && (
              <p class="mt-1 font-mono text-[10px] tracking-[0.2em] uppercase text-ink-soft">
                {data.testimonial.role}
              </p>
            )}
          </figcaption>
        </figure>
      </section>
    )}
  </article>
</BaseLayout>
