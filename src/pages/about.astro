---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE, CREDIBILITY } from '@/lib/site';

const stack = [
  {
    title: 'AI & generation',
    tools: ['ChatGPT', 'Claude', 'Kling', 'Seedance', 'Nano Banana', 'GPT image', 'Topaz', 'Krea', 'Stable Diffusion'],
  },
  {
    title: 'Design & motion',
    tools: ['Photoshop', 'After Effects', 'Premiere Pro', 'DaVinci Resolve', 'CapCut', 'Figma', 'Illustrator'],
  },
  {
    title: 'Web & code',
    tools: ['Astro', 'React', 'Three.js', 'Tailwind', 'Remotion (TSX video)', 'TypeScript'],
  },
];

const milestones = [
  {
    period: '2025 — Present',
    role: 'Independent · AI Product Visuals & Video Ad Creator',
    detail: 'Productized offers for DTC brands and tech startups. Top Rated on Upwork, ongoing retainer engagement.',
  },
  {
    period: '2024 — 2025',
    role: 'School · Media Lead',
    detail: 'In-house media production, content workflows, AI-assisted communications at scale.',
  },
  {
    period: '2023 — 2024',
    role: 'Social media agency · Designer + Filmmaker',
    detail: 'Brand-led design, video editing and shoot direction across restaurant, retail and SaaS clients.',
  },
  {
    period: '2020 — 2024',
    role: 'JUST · Bachelor of Design and Visual Communication',
    detail: 'Top of the batch. Ranked #1. Strong foundation in typography, branding, art direction.',
  },
];
---

<BaseLayout
  title="About"
  description="Mayyar Al-Sharqawi — AI Product Visuals & Video Ad Creator. Top Rated on Upwork, 100% Job Success Score, #1 ranked design graduate at JUST."
>
  <section class="relative pt-32 sm:pt-44 pb-16 sm:pb-24 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-cream via-paper to-cream-2"></div>
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -top-[10vmin] -right-[10vmin] h-[60vmin] w-[60vmin] rounded-full bg-coral/25 blur-[140px]"
    ></div>

    <div class="relative max-w-5xl mx-auto px-6 sm:px-10">
      <a
        href="/"
        data-cursor-link
        class="inline-flex items-center gap-2 text-sm text-ink-soft hover:text-ink"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M19 12H5" />
          <path d="M12 19l-7-7 7-7" />
        </svg>
        Back to home
      </a>

      <p class="mt-10 font-mono text-xs tracking-[0.3em] text-ink-soft">
        // ABOUT
      </p>

      <div class="mt-5 grid grid-cols-1 md:grid-cols-12 gap-10 items-start">
        <div class="md:col-span-7">
          <h1
            class="font-display leading-[0.95] tracking-tight text-balance"
            style="font-size: clamp(2.2rem, 6.5vw, 5.8rem);"
          >
            <span class="block">I’m Mayyar.</span>
            <span class="block">
              I make brands look <em class="not-italic text-coral">expensive</em>
            </span>
            <span class="block">without the studio bill.</span>
          </h1>

          <div class="mt-8 space-y-5 max-w-2xl text-ink-soft text-base sm:text-lg leading-relaxed text-pretty">
            <p>
              I’m a designer, filmmaker and AI specialist based in Amman, Jordan.
              Bachelor of Design and Visual Communication from JUST — ranked <strong class="text-ink">#1 in my batch</strong>.
              Four years freelancing on Upwork, where I’m <strong class="text-ink">Top Rated with 100% Job Success</strong> across
              15+ clients.
            </p>
            <p>
              I came up doing it the traditional way — photoshoots, video shoots, brand systems, motion design.
              Then AI changed what one person could ship in a week. So I rebuilt my entire workflow around it.
              I now generate, composite and finish product visuals and ads with AI as a creative collaborator,
              and finish every frame by hand in Photoshop, After Effects and Premiere.
            </p>
            <p>
              The result: a studio shoot’s look, an agency’s polish, delivered in 3–5 days at productized prices.
              That’s the only reason DTC brands and SaaS startups hire me. It’s the only reason this page exists.
            </p>
          </div>
        </div>

        <div class="md:col-span-5 relative">
          <div class="relative aspect-[4/5] overflow-hidden rounded-3xl border border-ink/10 bg-cream-2">
            <img
              src={SITE.portrait}
              alt="Mayyar Al-Sharqawi"
              class="absolute inset-0 w-full h-full object-cover"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-ink/20 via-transparent to-transparent"></div>
            <div class="absolute bottom-4 left-4 right-4 flex items-center justify-between text-cream font-mono text-[11px] tracking-[0.2em] uppercase">
              <span>Mayyar Al-Sharqawi</span>
              <span>Amman · Jordan</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="relative py-12 sm:py-16">
    <div class="max-w-5xl mx-auto px-6 sm:px-10">
      <p class="font-mono text-xs tracking-[0.3em] text-ink-soft">
        // CREDENTIALS
      </p>
      <div class="mt-6 grid grid-cols-2 sm:grid-cols-4 gap-x-6 gap-y-6">
        {CREDIBILITY.map((c) => (
          <div>
            <span class="font-display text-3xl sm:text-4xl leading-none text-ink">{c.value}</span>
            <span class="mt-2 block font-mono text-[10px] tracking-[0.2em] uppercase text-ink-soft">{c.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="relative py-16 sm:py-24">
    <div class="max-w-5xl mx-auto px-6 sm:px-10 grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-16">
      <div class="md:col-span-5">
        <p class="font-mono text-xs tracking-[0.3em] text-ink-soft">
          // TRACK
        </p>
        <h2 class="mt-5 font-display text-3xl sm:text-4xl leading-tight">
          Four years, three roles, one creative direction.
        </h2>
      </div>

      <ol class="md:col-span-7 relative pl-6 sm:pl-8 border-l border-ink/15 space-y-8">
        {milestones.map((m) => (
          <li class="relative">
            <span
              aria-hidden="true"
              class="absolute -left-[31px] sm:-left-[37px] top-2 w-3 h-3 rounded-full bg-coral ring-4 ring-cream"
            ></span>
            <p class="font-mono text-[11px] tracking-[0.22em] uppercase text-ink-soft">
              {m.period}
            </p>
            <p class="mt-2 font-display text-lg sm:text-xl text-ink">{m.role}</p>
            <p class="mt-2 text-ink-soft text-sm sm:text-base text-pretty">{m.detail}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="relative py-16 sm:py-24 bg-cream-2/60">
    <div class="max-w-5xl mx-auto px-6 sm:px-10">
      <p class="font-mono text-xs tracking-[0.3em] text-ink-soft">
        // STACK
      </p>
      <h2 class="mt-5 font-display text-3xl sm:text-4xl leading-tight">
        Tools I actually use — daily.
      </h2>

      <div class="mt-10 grid grid-cols-1 sm:grid-cols-3 gap-6">
        {stack.map((s) => (
          <div class="rounded-3xl border border-ink/10 bg-paper p-6">
            <p class="font-display text-xl text-ink">{s.title}</p>
            <ul class="mt-4 flex flex-wrap gap-2">
              {s.tools.map((t) => (
                <li class="font-mono text-[11px] tracking-[0.15em] uppercase text-ink-soft border border-ink/15 rounded-full px-3 py-1.5 bg-cream-2/40">
                  {t}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="relative py-20 sm:py-28">
    <div class="max-w-5xl mx-auto px-6 sm:px-10 text-center">
      <h2 class="font-display leading-[1] tracking-tight text-balance" style="font-size: clamp(2rem, 5vw, 4rem);">
        Need a brand to look like a campaign by next week?
      </h2>
      <p class="mt-5 max-w-xl mx-auto text-ink-soft text-base sm:text-lg text-pretty">
        Book a 20-minute call. I’ll diagnose where your visuals are leaking budget and walk you through a fixed-price plan to fix it.
      </p>
      <div class="mt-9 flex flex-wrap items-center justify-center gap-4">
        <a
          href={SITE.calendly}
          target="_blank"
          rel="noopener noreferrer"
          data-cursor-link
          class="group inline-flex items-center gap-3 rounded-full bg-ink text-cream px-7 py-4 text-base font-medium hover:bg-coral transition-colors"
        >
          Book a 20-min call
          <span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-cream text-ink group-hover:rotate-45 transition-transform">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14" />
              <path d="M13 5l7 7-7 7" />
            </svg>
          </span>
        </a>
        <a
          href="/services"
          data-cursor-link
          class="inline-flex items-center gap-2 rounded-full border border-ink/20 bg-paper px-6 py-4 text-sm font-medium text-ink hover:bg-ink hover:text-cream transition-colors"
        >
          See services &amp; pricing
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
