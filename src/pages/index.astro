---
/**
 * Home page — narrative order:
 * Hero → Marquee → Vision → About → Expertise → Work → Reel → AI Lab → Process → Experience → Why → Contact
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import Marquee from '@/components/Marquee.astro';
import Vision from '@/components/Vision.astro';
import About from '@/components/About.astro';
import Expertise from '@/components/Expertise.astro';
import Work from '@/components/Work.astro';
import Reel from '@/components/Reel.astro';
import AILab from '@/components/AILab.astro';
import Process from '@/components/Process.astro';
import Experience from '@/components/Experience.astro';
import WhyMe from '@/components/WhyMe.astro';
import Contact from '@/components/Contact.astro';
---

<BaseLayout>
  <Hero />
  <Marquee />
  <Vision />
  <About />
  <Expertise />
  <Work />
  <Reel />
  <AILab />
  <Process />
  <Experience />
  <WhyMe />
  <Contact />
</BaseLayout>
